    <!-- ================================================================ -->
    <!-- DUSTBIN (Realistic, two-tone: black base + green body + black rim) -->
    <!-- Built from stacked cylinders since SDF has no cone/frustum primitive -->
    <!-- ================================================================ -->
    <model name='dustbin'>
      <static>true</static>
      <pose>-0.52 0.4 0.175 0 0 0</pose>
      <link name='dustbin_link'>

      <!-- Lower section: dark base (common in real dustbins) -->
      <visual name='dustbin_base_visual'>
        <pose>0 0 -0.115 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <collision name='dustbin_base_collision'>
        <pose>0 0 -0.115 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Upper section: coloured body (green plastic look) -->
      <visual name='dustbin_body_visual'>
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.23</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.04 0.35 0.12 1</ambient>
          <diffuse>0.06 0.45 0.15 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
      <collision name='dustbin_body_collision'>
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.23</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Top rim: dark edge lip -->
      <visual name='dustbin_rim_visual'>
        <pose>0 0 0.185 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.155</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <collision name='dustbin_rim_collision'>
        <pose>0 0 0.185 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.155</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
      </collision>

      </link>
    </model>

    <!-- ================================================================ -->
    <!-- TOILET BRUSH (Realistic: white holder cup + blue handle + head)   -->
    <!-- ================================================================ -->
    <model name='toilet_brush'>
      <static>true</static>
      <pose>-0.5 -0.35 0 0 0 0</pose>
      <link name='brush_link'>

      <!-- Holder cup (base the brush stands in) -->
      <visual name='holder_visual'>
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
      <collision name='holder_collision'>
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Brush head (bristles) - cream/white -->
      <visual name='brush_head_visual'>
        <pose>0 0 0.14 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.8 1</ambient>
          <diffuse>0.92 0.92 0.88 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
      <collision name='brush_head_collision'>
        <pose>0 0 0.14 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>
      </collision>

      <!-- Handle - coloured plastic (blue) -->
      <visual name='brush_handle_visual'>
        <pose>0 0 0.33 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.25 0.65 1</ambient>
          <diffuse>0.1 0.32 0.75 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>
      </visual>
      <collision name='brush_handle_collision'>
        <pose>0 0 0.33 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
      </collision>

      </link>
    </model>

