<?xml version="1.0" encoding="utf-8"?>
<robot name="tcbase_v2">

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.0071866 1.1406E-16 0.24397" rpy="0 0 0" />
      <mass value="175.07" />
      <inertia
        ixx="8.7703"
        ixy="-1.3921E-16"
        ixz="0.27012"
        iyy="8.5903"
        iyz="-3.2313E-16"
        izz="10.319" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://tc_manipulation/meshes/mobile_robot/tc_base_v2_base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.89412 0.89412 0.89412 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://tc_manipulation/meshes/mobile_robot/tc_base_v2_base_link.STL" />
      </geometry>
    </collision>
  </link>
  
  <!-- Joint connecting base_footprint to TBot base -->
  <joint name="base_footprint_to_tbot" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <link name="front_left">
    <inertial>
      <origin xyz="0.00024743 0.0001026 -0.015" rpy="0 0 0" />
      <mass value="0.52779" />
      <inertia
        ixx="0.00078383"
        ixy="3.0147E-06"
        ixz="-5.1812E-22"
        iyy="0.00077781"
        iyz="-1.2199E-22"
        izz="0.0014825" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://tc_manipulation/meshes/mobile_robot/tbot_front_left.STL" />
      </geometry>
      <material name="">
        <color rgba="0.89412 0.89412 0.89412 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <!-- <sphere radius="0.075"/> -->
        <mesh filename="package://tc_manipulation/meshes/mobile_robot/tbot_front_left.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="front_left_joint" type="continuous">
    <origin xyz="0.25 0.31 0.04" rpy="1.5707963267949 0 0" />
    <parent link="base_link" />
    <child link="front_left" />
    <axis xyz="0 0 -1" />
    <!-- <limit effort="100" velocity="10" /> -->
  </joint>

  <link name="front_right">
    <inertial>
      <origin xyz="0.00026786 6.9389E-18 0.015" rpy="0 0 0" />
      <mass value="0.52779" />
      <inertia
        ixx="0.00078508"
        ixy="-1.8843E-38"
        ixz="-1.9616E-22"
        iyy="0.00077656"
        iyz="-1.1542E-36"
        izz="0.0014825" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://tc_manipulation/meshes/mobile_robot/tbot_front_right.STL" />
      </geometry>
      <material name="">
        <color rgba="0.89412 0.89412 0.89412 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <!-- <sphere radius="0.075"/> -->
         <mesh filename="package://tc_manipulation/meshes/mobile_robot/tbot_front_right.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="front_right_joint" type="continuous">
    <origin xyz="0.25 -0.31 0.04" rpy="1.5707963267949 0 0" />
    <parent link="base_link" />
    <child link="front_right" />
    <axis xyz="0 0 -1" />
    <!-- <limit effort="100" velocity="10" /> -->
  </joint>

  <link name="rear_left">
    <inertial>
      <origin xyz="0.00024743 0.0001026 -0.015" rpy="0 0 0" />
      <mass value="0.52779" />
      <inertia
        ixx="0.00078383"
        ixy="3.0147E-06"
        ixz="-3.5269E-22"
        iyy="0.00077781"
        iyz="-1.3491E-22"
        izz="0.0014825" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://tc_manipulation/meshes/mobile_robot/tbot_rear_left.STL" />
      </geometry>
      <material name="">
        <color rgba="0.89412 0.89412 0.89412 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <!-- <sphere radius="0.075"/> -->
        <mesh filename="package://tc_manipulation/meshes/mobile_robot/tbot_rear_left.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="rear_left_joint" type="continuous">
    <origin xyz="-0.25 0.31 0.04" rpy="1.5707963267949 0 0" />
    <parent link="base_link" />
    <child link="rear_left" />
    <axis xyz="0 0 -1" />
    <!-- <limit effort="100" velocity="10" /> -->
  </joint>

  <link name="rear_right">
    <inertial>
      <origin xyz="0.00026786 0 0.015" rpy="0 0 0" />
      <mass value="0.52779" />
      <inertia
        ixx="0.00078508"
        ixy="-1.2857E-36"
        ixz="-1.9616E-22"
        iyy="0.00077656"
        iyz="-3.6364E-36"
        izz="0.0014825" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://tc_manipulation/meshes/mobile_robot/tbot_Rear_right.STL" />
      </geometry>
      <material name="">
        <color rgba="0.89412 0.89412 0.89412 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <!-- <sphere radius="0.075"/> -->
         <mesh filename="package://tc_manipulation/meshes/mobile_robot/tbot_Rear_right.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="rear_right_joint" type="continuous">
    <origin xyz="-0.25 -0.31 0.04" rpy="1.5707963267949 0 0" />
    <parent link="base_link" />
    <child link="rear_right" />
    <axis xyz="0 0 -1" />
    <!-- <limit effort="100" velocity="10" /> -->
  </joint>

   <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_joint</left_joint>
      <right_joint>front_right_joint</right_joint>
      <left_joint>rear_left_joint</left_joint>
      <right_joint>rear_right_joint</right_joint>
      <wheel_separation>0.62</wheel_separation>
      <wheel_radius>0.075</wheel_radius>
      <max_wheel_torque>1000</max_wheel_torque>
      <max_wheel_acceleration>50.0</max_wheel_acceleration>
      <max_linear_velocity>5.0</max_linear_velocity>
      <min_linear_velocity>-5.0</min_linear_velocity>
      <max_angular_velocity>10.0</max_angular_velocity>
      <min_angular_velocity>-10.0</min_angular_velocity>
      <topic>cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>  
  </gazebo>

   <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_joint</joint_name>
      <joint_name>front_right_joint</joint_name>
      <joint_name>rear_left_joint</joint_name>
      <joint_name>rear_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- <ros2_control name="diff_drive" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="front_left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
    </joint>
    
  <ros2_control> -->

  <gazebo reference="front_left">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="rear_left">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="rear_right">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>
  <gazebo reference="front_right">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
  </gazebo>

</robot>