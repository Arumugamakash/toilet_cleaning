<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="combined_robot">

  <!-- TBot include -->
  <xacro:include filename="$(find tc_manipulation)/urdf/tc_base_v2.urdf.xacro"/>
  <!-- xArm7 include -->
  <xacro:include filename="$(find tc_manipulation)/urdf/xarm7.urdf.xacro"/>

  <!-- xArm7 macro call -->
  <xacro:xarm7_urdf prefix=""/>

  <!-- Arm to TBot base joint -->
  <joint name="tbot_to_arm" type="fixed">
    <parent link="base_link"/>
    <child link="link_base"/>
    <origin xyz="0.23492 0.0 0.44766" rpy="0 -0.69813 3.1416"/>
  </joint>

  <!-- Controller Manager for the Arm -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find tc_manipulation)/config/arm_controller.yaml</parameters>
    </plugin>
  </gazebo>

</robot>